# Salin file ini menjadi .env lalu isi nilainya:  cp .env.example .env
# File .env diabaikan git (lihat .gitignore), jadi password asli tidak ikut ter-commit.

# Backend Laravel. Buat dengan: docker run --rm php:8.3-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=

# MySQL
DB_PASSWORD=ganti-dengan-password-db
DB_ROOT_PASSWORD=ganti-dengan-password-root-db

# Grafana. Password wajib diisi (compose menolak jalan bila kosong) dan
# jangan pakai "admin". Minimal 12 karakter campuran huruf, angka, simbol.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ganti-dengan-password-grafana-yang-kuat
